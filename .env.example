# OpenProject
OPENPROJECT_HOST=localhost:8080
OPENPROJECT_SECRET_KEY_BASE=   # openssl rand -hex 64
OPENPROJECT_PROJECT=demo-agents

# Cloudflare Tunnel (Zero Trust > Networks > Tunnels), public hostname -> http://nginx:80
CLOUDFLARE_TUNNEL_TOKEN=

# credits watcher task ID
OPENPROJECT_TRACKING_TASK_ID=

# OpenProject users API Keys
OP_KEY_SCOUT=
OP_KEY_CODER=
OP_KEY_REVIEWER=
OP_KEY_ORCHESTRATOR=
WEBHOOK_SECRET=                # openssl rand -hex 32, for the webhook

# Claude Platform users keys
ANTHROPIC_KEY_SCOUT=
ANTHROPIC_KEY_CODER=
ANTHROPIC_KEY_REVIEWER=
ANTHROPIC_ADMIN_KEY=
ANTHROPIC_WORKSPACE_IDS=
AGENT_THINKING=                # off (default), low, medium, high, xhigh, max
# claude-haiku-5-5: supported until at least 2027-10-07. A new model also needs its price in orchestrator/pricing.json
MODEL_SCOUT=claude-haiku-5-5
MODEL_CODER=claude-haiku-5-5
MODEL_REVIEWER=claude-haiku-5-5

DEMO_BUDGET_USD=5


OTEL_SDK_DISABLED=false

# Dev: nginx with self-signed certificate
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
